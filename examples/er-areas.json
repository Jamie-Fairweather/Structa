{
  "type": "er",
  "title": "School baking club",
  "description": "Members bake for the club's tasting days, and other members taste, with ingredients from the club's pantry. An allergy note names an ingredient in a bake by its two-column key.",
  "groupAreas": true,
  "areas": [
    { "id": "people", "label": "Members" },
    { "id": "kitchen", "label": "Kitchen" },
    { "id": "pantry", "label": "Pantry", "parent": "kitchen" }
  ],
  "nodes": [
    {
      "id": "members",
      "label": "members",
      "area": "people",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "name", "type": "text" },
        { "name": "email", "type": "text", "unique": true }
      ]
    },
    {
      "id": "bakes",
      "label": "bakes",
      "area": "kitchen",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "baker_id", "type": "uuid", "fk": true },
        { "name": "taster_id", "type": "uuid", "fk": true, "nullable": true },
        { "name": "recipe", "type": "text" },
        { "name": "baked_on", "type": "date" }
      ]
    },
    {
      "id": "bake-ingredients",
      "label": "bake_ingredients",
      "area": "pantry",
      "columns": [
        { "name": "bake_id", "type": "uuid", "pk": true, "fk": true },
        { "name": "ingredient_code", "type": "text", "pk": true, "fk": true },
        { "name": "grams", "type": "int" }
      ]
    },
    {
      "id": "ingredients",
      "label": "ingredients",
      "area": "pantry",
      "columns": [
        { "name": "code", "type": "text", "pk": true },
        { "name": "description", "type": "text" },
        { "name": "cost_per_kg", "type": "numeric(6,2)" }
      ]
    },
    {
      "id": "allergy-notes",
      "label": "allergy_notes",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "bake_id", "type": "uuid", "fk": true },
        { "name": "ingredient_code", "type": "text", "fk": true },
        { "name": "note", "type": "text" }
      ]
    }
  ],
  "edges": [
    { "from": "bakes", "to": "members", "fromColumn": "baker_id", "toColumn": "id", "fromCardinality": "zero-or-many", "toCardinality": "one", "label": "baked by" },
    { "from": "bakes", "to": "members", "fromColumn": "taster_id", "toColumn": "id", "fromCardinality": "zero-or-many", "toCardinality": "zero-or-one", "label": "tasted by" },
    { "from": "bake-ingredients", "to": "bakes", "fromColumn": "bake_id", "toColumn": "id", "fromCardinality": "zero-or-many", "toCardinality": "one" },
    { "from": "bake-ingredients", "to": "ingredients", "fromColumn": "ingredient_code", "toColumn": "code", "fromCardinality": "zero-or-many", "toCardinality": "one" },
    { "from": "allergy-notes", "to": "bake-ingredients", "fromCardinality": "zero-or-many", "toCardinality": "one", "label": "for" }
  ]
}
