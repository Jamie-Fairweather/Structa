{
  "type": "class",
  "title": "School clubs: joining a club online",
  "description": "Parents can now sign their child up for a club from the app. Each class is tagged with the part of the system it lives in.",
  "areas": [
    { "id": "app", "label": "Parents app" },
    { "id": "clubs", "label": "Clubs" },
    { "id": "activities", "label": "Activities", "parent": "clubs" },
    { "id": "messages", "label": "Messages" }
  ],
  "nodes": [
    {
      "id": "screen",
      "label": "JoinClubScreen",
      "area": "app",
      "status": "new",
      "methods": [
        { "text": "show(club: Club): void", "visibility": "public" },
        { "text": "confirm(child: Pupil, from: Term): void", "visibility": "public" }
      ]
    },
    {
      "id": "office",
      "label": "ClubOffice",
      "area": "clubs",
      "status": "changed",
      "methods": [
        { "text": "list(term: Term): Club[]", "visibility": "public", "status": "unchanged" },
        { "id": "join", "text": "join(club: Club, child: Pupil, from: Term): Membership", "visibility": "public", "status": "new" },
        { "text": "paperForms(): Form[]", "visibility": "private", "status": "removed" }
      ]
    },
    {
      "id": "membership",
      "label": "Membership",
      "description": "One pupil in one club from a given term.",
      "area": "clubs",
      "status": "new",
      "properties": [
        { "text": "from: Term", "visibility": "public" },
        { "text": "consentGiven: bool", "visibility": "public" }
      ]
    },
    {
      "id": "club",
      "label": "Club",
      "area": "activities",
      "status": "unchanged",
      "properties": [
        { "text": "name: string", "visibility": "public" },
        { "text": "meetsOn: Weekday", "visibility": "public" }
      ],
      "more": 4
    },
    {
      "id": "reminder",
      "label": "FirstMeetingReminder",
      "area": "messages",
      "status": "new",
      "methods": [{ "text": "sendDayBefore(membership: Membership): void", "visibility": "public" }]
    },
    {
      "id": "clock",
      "label": "Clock",
      "description": "Shared by every part of the system.",
      "methods": [{ "text": "today(): Date", "visibility": "public" }]
    }
  ],
  "edges": [
    { "from": "screen", "to": "office", "kind": "association", "label": "joins through", "status": "new" },
    { "from": "office", "to": "membership", "kind": "association", "label": "makes", "status": "new" },
    { "from": "membership", "to": "club", "kind": "association", "label": "for", "status": "new" },
    { "from": "reminder", "to": "membership", "kind": "association", "label": "reads", "status": "new" },
    { "from": "reminder", "to": "clock", "kind": "association" }
  ]
}
