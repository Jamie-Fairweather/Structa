{
  "type": "class",
  "title": "Tool library: reserving a tool online",
  "description": "Members can now reserve a tool from the app before they come in. Each class is tagged with the part of the system it lives in.",
  "areas": [
    { "id": "app", "label": "Members app" },
    { "id": "lending", "label": "Lending" },
    { "id": "catalogue", "label": "Catalogue", "parent": "lending" },
    { "id": "messages", "label": "Messages" }
  ],
  "nodes": [
    {
      "id": "screen",
      "label": "ReserveToolScreen",
      "area": "app",
      "status": "new",
      "methods": [
        { "text": "show(tool: Tool): void", "visibility": "public" },
        { "text": "confirm(from: Date, to: Date): void", "visibility": "public" }
      ]
    },
    {
      "id": "desk",
      "label": "LoanDesk",
      "area": "lending",
      "status": "changed",
      "methods": [
        { "text": "lend(tool: Tool, member: Member): Loan", "visibility": "public", "status": "unchanged" },
        { "id": "reserve", "text": "reserve(tool: Tool, member: Member, from: Date): Reservation", "visibility": "public", "status": "new" },
        { "text": "holdShelf(): Tool[]", "visibility": "private", "status": "removed" }
      ]
    },
    {
      "id": "reservation",
      "label": "Reservation",
      "description": "A tool kept back for one member from a given day.",
      "area": "lending",
      "status": "new",
      "properties": [
        { "text": "from: Date", "visibility": "public" },
        { "text": "collected: bool", "visibility": "public" }
      ]
    },
    {
      "id": "tool",
      "label": "Tool",
      "area": "catalogue",
      "status": "unchanged",
      "properties": [
        { "text": "name: string", "visibility": "public" },
        { "text": "condition: Condition", "visibility": "public" }
      ],
      "more": 4
    },
    {
      "id": "reminder",
      "label": "CollectionReminder",
      "area": "messages",
      "status": "new",
      "methods": [{ "text": "sendDayBefore(reservation: Reservation): void", "visibility": "public" }]
    },
    {
      "id": "clock",
      "label": "Clock",
      "description": "Shared by every part of the system.",
      "methods": [{ "text": "today(): Date", "visibility": "public" }]
    }
  ],
  "edges": [
    { "from": "screen", "to": "desk", "kind": "association", "label": "reserves through", "status": "new" },
    { "from": "desk", "to": "reservation", "kind": "association", "label": "makes", "status": "new" },
    { "from": "reservation", "to": "tool", "kind": "association", "label": "holds", "status": "new" },
    { "from": "reminder", "to": "reservation", "kind": "association", "label": "reads", "status": "new" },
    { "from": "reminder", "to": "clock", "kind": "association" }
  ]
}
