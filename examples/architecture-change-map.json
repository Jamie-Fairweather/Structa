{
  "type": "architecture",
  "title": "Town museum: taking an object off display",
  "description": "Curators can now take an object off display from the admin portal. Its audio guide stops and floor map pin go at once, so the nightly guide export is retired. Each part of the system is drawn as a box.",
  "groupAreas": true,
  "areas": [
    { "id": "portal", "label": "Admin portal" },
    { "id": "api", "label": "API" },
    { "id": "services", "label": "Services" },
    { "id": "guide", "label": "Audio guide", "parent": "services" },
    { "id": "data", "label": "Database" }
  ],
  "nodes": [
    { "id": "console", "label": "Curator admin", "kind": "ui", "area": "portal", "status": "changed", "description": "Adds a Take off display button" },
    {
      "id": "dialog",
      "label": "TakeOffDisplayDialog",
      "kind": "class",
      "area": "portal",
      "status": "new",
      "methods": [
        { "text": "open(object: ObjectId): void", "visibility": "public" },
        { "text": "confirm(reason: string): void", "visibility": "public" }
      ]
    },
    { "id": "gateway", "label": "Museum API", "kind": "api", "area": "api", "status": "unchanged" },
    {
      "id": "controller",
      "label": "DisplaysController",
      "kind": "class",
      "area": "api",
      "status": "changed",
      "methods": [
        { "text": "list(gallery: GalleryId): Display[]", "visibility": "public", "status": "unchanged" },
        { "text": "takeOff(id: ObjectId, reason: string): Removal", "visibility": "public", "status": "new" },
        { "text": "move(id: ObjectId, to: CaseId): Display", "visibility": "public", "status": "changed" },
        { "text": "exportGuide(day: Date): Csv", "visibility": "public", "status": "removed" }
      ],
      "more": 2
    },
    { "id": "collection", "label": "Collection service", "kind": "service", "area": "services", "description": "Every object the museum holds" },
    {
      "id": "removals",
      "label": "RemovalService",
      "kind": "class",
      "area": "services",
      "status": "new",
      "properties": [{ "text": "displays: DisplayStore", "visibility": "private" }],
      "methods": [
        { "text": "takeOff(object: MuseumObject, reason: string): Removal", "visibility": "public" },
        { "text": "stopsFor(object: MuseumObject): GuideStop[]", "visibility": "private" }
      ]
    },
    { "id": "events", "label": "Display events", "kind": "queue", "area": "services", "status": "new" },
    { "id": "map", "label": "Floor map", "kind": "service", "area": "services", "status": "new", "description": "Drops the object's pin" },
    { "id": "stops", "label": "Guide stops", "kind": "service", "area": "guide", "status": "changed", "description": "Skips every stop for the object at once" },
    { "id": "export", "label": "Nightly guide export", "kind": "job", "area": "guide", "status": "removed" },
    { "id": "db", "label": "Museum database", "kind": "database", "area": "data", "status": "changed", "description": "Adds a removals table" }
  ],
  "edges": [
    { "from": "console", "to": "gateway", "label": "GET /displays" },
    { "from": "dialog", "to": "gateway", "label": "DELETE /displays/{id}", "status": "new", "emphasis": true },
    { "from": "gateway", "to": "controller", "emphasis": true },
    { "from": "controller", "to": "collection", "label": "move object", "status": "changed" },
    { "from": "controller", "to": "removals", "label": "take off", "status": "new", "emphasis": true },
    { "from": "removals", "to": "db", "label": "save removal", "status": "new", "emphasis": true },
    { "from": "removals", "to": "events", "kind": "async", "label": "object removed", "status": "new" },
    { "from": "events", "to": "stops", "kind": "async", "label": "skip its stops", "status": "new" },
    { "from": "events", "to": "map", "kind": "async", "label": "drop its pin", "status": "new" },
    { "from": "collection", "to": "db", "label": "read objects", "status": "unchanged" },
    { "from": "stops", "to": "db", "label": "mark skipped", "status": "changed" },
    { "from": "export", "to": "db", "label": "read displays", "status": "removed" }
  ]
}
