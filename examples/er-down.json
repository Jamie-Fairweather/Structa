        { "name": "finished_at", "type": "timestamptz", "nullable": true }
      ]
    },
    {
      "id": "objects",
      "label": "objects",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "donor_id", "type": "uuid", "fk": true },
        { "name": "kind", "type": "text" },
        { "name": "condition", "type": "text" }
      ]
    },
    {
