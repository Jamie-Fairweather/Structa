        { "name": "cost", "type": "numeric(6,2)", "nullable": true }
      ]
    },
    {
      "id": "treatments",
      "label": "treatments",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "object_id", "type": "uuid", "fk": true },
        { "name": "conservator_id", "type": "uuid", "fk": true, "nullable": true },
