    { "from": "treatments", "to": "conservators", "fromColumn": "conservator_id", "toColumn": "id", "fromCardinality": "zero-or-many", "toCardinality": "zero-or-one" },
    { "from": "objects", "to": "donors", "fromColumn": "donor_id", "toColumn": "id", "fromCardinality": "zero-or-many", "toCardinality": "one" }
  ]
