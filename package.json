{
  "name": "structa",
  "version": "0.0.0",
  "private": true,
  "description": "Turn a JSON diagram description into SVG or PNG for agents and skills.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "generate": "bun scripts/generate-fonts.ts",
    "typecheck": "bun run generate && tsc",
    "test": "bun run generate && vitest run",
    "build": "bun run generate && bun scripts/build.ts",
    "gallery": "bun run build && bun scripts/gallery.ts",
    "release": "bun run generate && bun scripts/release.ts",
    "readme-images": "bun run build && bun scripts/readme-images.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "20.19.43",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "harfbuzzjs": "1.6.4",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "elkjs": "0.12.1"
  }
}
